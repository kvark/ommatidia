+    pub(super) fn workgroup_type_id(&self, type_id: Word) -> Word {
+        self.workgroup_type_ids
+            .get(&type_id)
+            .copied()
+            .unwrap_or(type_id)
+    }
+
+    fn collect_workgroup_types(&mut self, module: &crate::Module, ty: Handle<crate::Type>) {
+        if !matches!(
+            module.types[ty].inner,
+            crate::TypeInner::Array { .. } | crate::TypeInner::Struct { .. }
+        ) {
+            return;
+        }
+        if !self.workgroup_type_handles.insert(ty) {
+            return;
+        }
+        match module.types[ty].inner {
+            crate::TypeInner::Array { base, .. } => self.collect_workgroup_types(module, base),
+            crate::TypeInner::Struct { ref members, .. } => {
+                for member in members {
+                    self.collect_workgroup_types(module, member.ty);
+                }
+            }
+            _ => (),
+        }
+    }
+
+    fn write_workgroup_type(
+        &mut self,
+        module: &crate::Module,
+        ty: Handle<crate::Type>,
+        original_id: Word,
+    ) -> Result<(), Error> {
+        if !self.workgroup_type_handles.contains(&ty) {
+            return Ok(());
+        }
+        let id = self.id_gen.next();
+        let instruction = match module.types[ty].inner {
+            crate::TypeInner::Array { base, size, .. } => {
+                let base_id = self.get_handle_type_id(base);
+                let base_id = self.workgroup_type_id(base_id);
+                match size.resolve(module.to_ctx())? {
+                    crate::proc::IndexableLength::Known(length) => {
+                        let length_id = self.get_index_constant(length);
+                        Instruction::type_array(id, base_id, length_id)
+                    }
+                    crate::proc::IndexableLength::Dynamic => {
+                        unreachable!("unsized workgroup array")
+                    }
+                }
+            }
+            crate::TypeInner::Struct { ref members, .. } => {
+                let members: Vec<_> = members
+                    .iter()
+                    .map(|member| {
+                        let id = self.get_handle_type_id(member.ty);
+                        self.workgroup_type_id(id)
+                    })
+                    .collect();
+                Instruction::type_struct(id, &members)
+            }
+            _ => return Ok(()),
+        };
+        instruction.to_words(&mut self.logical_layout.declarations);
+        self.workgroup_type_ids.insert(original_id, id);
+        Ok(())
+    }
+
+    pub(super) fn convert_workgroup_value(
+        &mut self,
+        module: &crate::Module,
+        ty: Handle<crate::Type>,
+        value: Word,
+        to_workgroup: bool,
+        body: &mut Vec<Instruction>,
+    ) -> Result<Word, Error> {
+        let regular = self.get_handle_type_id(ty);
+        let workgroup = self.workgroup_type_id(regular);
+        if workgroup == regular {
+            return Ok(value);
+        }
+        let components = match module.types[ty].inner {
+            crate::TypeInner::Array { base, size, .. } => match size.resolve(module.to_ctx())? {
+                crate::proc::IndexableLength::Known(length) => vec![base; length as usize],
+                crate::proc::IndexableLength::Dynamic => unreachable!("unsized workgroup array"),
+            },
+            crate::TypeInner::Struct { ref members, .. } => members.iter().map(|m| m.ty).collect(),
+            _ => unreachable!("workgroup variant must be composite"),
+        };
+        let mut values = Vec::with_capacity(components.len());
+        for (index, component) in components.into_iter().enumerate() {
+            let regular_component = self.get_handle_type_id(component);
+            let source_type = if to_workgroup {
+                regular_component
+            } else {
+                self.workgroup_type_id(regular_component)
+            };
+            let extracted = self.id_gen.next();
+            body.push(Instruction::composite_extract(
+                source_type,
+                extracted,
+                value,
+                &[index as u32],
+            ));
+            values.push(self.convert_workgroup_value(
+                module,
+                component,
+                extracted,
+                to_workgroup,
+                body,
+            )?);
+        }
+        let result = self.id_gen.next();
+        body.push(Instruction::composite_construct(
+            if to_workgroup { workgroup } else { regular },
+            result,
+            &values,
+        ));
+        Ok(result)
+    }
