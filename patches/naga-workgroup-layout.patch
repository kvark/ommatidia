+++ b/naga/tests/naga/spirv_workgroup_layout.rs
@@ -0,0 +1,159 @@
+#![cfg(all(feature = "wgsl-in", spv_out))]
+
+use naga::{back::spv, valid};
+use std::{
+    io::Write,
+    process::{Command, Stdio},
+};
+
+const SOURCE: &str = r#"
+struct Payload {
+    basis: mat2x3<f32>,
+    values: array<vec3<f32>, 3>,
+    tag: u32,
+}
+@group(0) @binding(0) var<storage, read_write> backing: array<Payload, 4>;
+@group(0) @binding(1) var<uniform> control: Payload;
+var<workgroup> wg_data: array<Payload, 4>;
+var<workgroup> counters: array<atomic<u32>, 4>;
+fn copy(index: u32) -> Payload {
+    wg_data[index] = control;
+    return wg_data[index];
+}
+@compute @workgroup_size(4)
+fn main(@builtin(local_invocation_index) lane: u32) {
+    if lane == 0u { wg_data = backing; }
+    workgroupBarrier();
+    backing[lane] = copy(lane);
+    let uniform_value = workgroupUniformLoad(&wg_data[0]);
+    backing[lane].basis = uniform_value.basis;
+    let old = atomicAdd(&counters[0], lane);
+    backing[lane].tag += old;
+}
+"#;
+
+fn modules() -> Vec<Vec<u32>> {
+    let module = naga::front::wgsl::parse_str(SOURCE).unwrap();
+    let info = valid::Validator::new(valid::ValidationFlags::all(), valid::Capabilities::all())
+        .validate(&module)
+        .unwrap();
+    let mut modules = Vec::new();
+    for version in [(1, 3), (1, 4)] {
+        for initialize in [
+            spv::ZeroInitializeWorkgroupMemoryMode::None,
+            spv::ZeroInitializeWorkgroupMemoryMode::Polyfill,
+            spv::ZeroInitializeWorkgroupMemoryMode::Native,
+        ] {
+            let mut options = spv::Options {
+                lang_version: version,
+                zero_initialize_workgroup_memory: initialize,
+                ..Default::default()
+            };
+            options.bounds_check_policies.index = naga::proc::BoundsCheckPolicy::ReadZeroSkipWrite;
+            let mut writer = spv::Writer::new(&options).unwrap();
+            let mut first = Vec::new();
+            writer
+                .write(&module, &info, None, &None, &mut first)
+                .unwrap();
+            let mut second = Vec::new();
+            writer
+                .write(&module, &info, None, &None, &mut second)
+                .unwrap();
+            assert_eq!(
+                first, second,
+                "workgroup type cache must reset with the writer"
+            );
+            modules.push(first);
+        }
+    }
+    modules
+}
+
+#[test]
+fn workgroup_has_no_layout_but_shared_buffer_types_keep_it() {
+    for words in modules() {
+        let mut types = naga::FastHashMap::default();
+        let mut decorated = Vec::new();
+        let mut variables = Vec::new();
+        let mut position = 5;
+        while position < words.len() {
+            let size = (words[position] >> 16) as usize;
+            let operands = &words[position + 1..position + size];
+            let opcode = words[position] & 65535;
+            if [
+                spirv::Op::TypeArray,
+                spirv::Op::TypeStruct,
+                spirv::Op::TypePointer,
+            ]
+            .iter()
+            .any(|op| opcode == *op as u32)
+            {
+                let children = if opcode == spirv::Op::TypeArray as u32 {
+                    vec![operands[1]]
+                } else if opcode == spirv::Op::TypePointer as u32 {
+                    vec![operands[2]]
+                } else {
+                    operands[1..].to_vec()
+                };
+                types.insert(operands[0], children);
+            }
+            if opcode == spirv::Op::Decorate as u32
+                && operands[1] == spirv::Decoration::ArrayStride as u32
+                || opcode == spirv::Op::MemberDecorate as u32
+                    && [spirv::Decoration::Offset, spirv::Decoration::MatrixStride]
+                        .iter()
+                        .any(|d| operands[2] == *d as u32)
+            {
+                decorated.push(operands[0]);
+            }
+            if opcode == spirv::Op::Variable as u32 {
+                variables.push((operands[0], operands[2]));
+            }
+            position += size;
+        }
+        for (ty, class) in variables {
+            let mut pending = vec![ty];
+            let mut has_layout = false;
+            while let Some(ty) = pending.pop() {
+                has_layout |= decorated.contains(&ty);
+                if let Some(children) = types.get(&ty) {
+                    pending.extend(children);
+                }
+            }
+            if class == spirv::StorageClass::Workgroup as u32 {
+                assert!(!has_layout);
+            }
+            if class == spirv::StorageClass::StorageBuffer as u32
+                || class == spirv::StorageClass::Uniform as u32
+            {
+                assert!(has_layout);
+            }
+        }
+    }
+}
+
+#[test]
+#[ignore = "requires spirv-val"]
+fn workgroup_layout_passes_spirv_validation() {
+    for words in modules() {
+        let mut child = Command::new("spirv-val")
+            .args(["--target-env", "vulkan1.3"])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .unwrap();
+        child
+            .stdin
+            .take()
+            .unwrap()
+            .write_all(bytemuck::cast_slice(&words))
+            .unwrap();
+        let output = child.wait_with_output().unwrap();
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+    }
+}
